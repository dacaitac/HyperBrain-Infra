# OCI credentials — copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored; never commit it.
# To encrypt a backup: sops --encrypt --age <PUBLIC_KEY> terraform.tfvars > terraform.tfvars.enc

tenancy_ocid     = "ocid1.tenancy.oc1..aaaa..."
user_ocid        = "ocid1.user.oc1..aaaa..."
fingerprint      = "aa:bb:cc:dd:..."
private_key_path = "/Users/danielc/<key-file>.pem"

# Region: us-ashburn-1 (Bogotá may lack A1.Flex free-tier capacity)
region = "us-ashburn-1"

compartment_id = "ocid1.compartment.oc1..aaaa..."

# Instance sizing — free tier: max 4 OCPUs + 24 GB RAM across all A1 instances
ocpus         = 2
memory_in_gbs = 12

# SSH public key content (output of: cat ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA..."

# Change to 1 or 2 if A1.Flex capacity is exhausted in the default availability domain
ad_index = 0
