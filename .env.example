# =============================================================================
# HyperBrain-Infra — Environment Template
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=hyperbrain
POSTGRES_PASSWORD=hyperbrain_dev_change_me
POSTGRES_DB=hyperbrain

# ── PostgREST ─────────────────────────────────────────────────────────────────
# Role must exist in PG (created by infrastructure/postgres/01-init.sql)
PGRST_DB_ANON_ROLE=anon

# ── GoTrue (Supabase Auth) ────────────────────────────────────────────────────
# Change JWT_SECRET to a long random string in a real deployment
JWT_SECRET=super-secret-jwt-token-for-hyperbrain-dev-only-replace-this-32chars+

GOTRUE_SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:9999

# ── AWS / LocalStack ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ── SQS Queue URLs ─────────────────────────────────────────────────────────────
# LocalStack (dev):  http://localhost:4566/000000000000/<queue-name>
# AWS prod:         https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>
# Obtain prod URLs with: cd terraform/sqs && terraform output
SQS_SYNC_EVENTS_URL=http://localhost:4566/000000000000/sync-events.fifo
SQS_CORE_EVENTS_URL=http://localhost:4566/000000000000/core-events
SQS_IA_JOBS_URL=http://localhost:4566/000000000000/ia-jobs
SQS_APPLE_COMMANDS_URL=http://localhost:4566/000000000000/apple-commands.fifo
SQS_APPLE_COMMANDS_RESULTS_URL=http://localhost:4566/000000000000/apple-commands-results.fifo

# Queue names/URLs injected into hyperbrain-core (Spring property placeholders).
# Dev default resolves against LocalStack; for real AWS set the full queue URLs.
SQS_QUEUE_APPLE_COMMANDS=apple-commands.fifo
SQS_QUEUE_APPLE_COMMANDS_RESULTS=apple-commands-results.fifo
# true only when apple-commands-results.fifo exists in the target account (HU-09c)
SYNC_RESULTS_CONSUMER_ENABLED=true

# ── Notion sync (HU-10, CA-12) ────────────────────────────────────────────────
# Integration token from https://www.notion.so/my-integrations. SECURITY: rotate
# the token exposed in plaintext in the legacy repo (Legacy/HyperBrain-be/.env)
# before enabling. After filling these in, run
# scripts/provision-notion-credential.sh to upsert the SYNC_CREDENTIAL row.
NOTION_SYNC_ENABLED=false
NOTION_TOKEN=
NOTION_TASKS_DATA_SOURCE_ID=1bf8bc9c5d918171b7ea000b7e326082
NOTION_CYCLES_DATA_SOURCE_ID=1bf8bc9c5d9181e78737000b45812f45

# ── Notion inbound webhooks (ADR-011, #41/#42) ────────────────────────────────
# Function URL of the notion-webhook Lambda: cd lambda/notion-webhook && terraform output
# The webhook secret lives in SSM (/hyperbrain/notion/webhook-secret), not here;
# this env var is only a dev convenience for the LocalStack smoke test.
NOTION_WEBHOOK_FUNCTION_URL=
NOTION_WEBHOOK_SECRET=
