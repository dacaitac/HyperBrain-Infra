# =============================================================================
# HyperBrain-Infra — Environment Template
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=hyperbrain
POSTGRES_PASSWORD=hyperbrain_dev_change_me
POSTGRES_DB=hyperbrain

# ── PostgREST ─────────────────────────────────────────────────────────────────
# Role must exist in PG (created by infrastructure/postgres/01-init.sql)
PGRST_DB_ANON_ROLE=anon

# ── GoTrue (Supabase Auth) ────────────────────────────────────────────────────
# Change JWT_SECRET to a long random string in a real deployment
JWT_SECRET=super-secret-jwt-token-for-hyperbrain-dev-only-replace-this-32chars+

GOTRUE_SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:9999

# ── AWS / LocalStack ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
