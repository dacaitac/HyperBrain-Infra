[Unit]
Description=Daily HyperBrain PostgreSQL backup at 03:00 local time
Documentation=https://github.com/dacaitac/HyperBrain-Infra/blob/main/docs/backup-restore.md

[Timer]
# Fire every day at 03:00 local time.
OnCalendar=*-*-* 03:00:00
# Re-run immediately after boot if the last scheduled run was missed (e.g. host was off).
Persistent=true
Unit=hyperbrain-backup.service

[Install]
WantedBy=timers.target
